# Optional. Everything has a safe default; Mock needs no settings and no network.
# Read from the shared settings file (~/Development/.env, or the file named by STANDALONE_ENV) and from the environment (the environment wins).
# PORT must be 7804 (this app's one allocated port).
PORT=7804
# FIELD_NOTES_BIND=127.0.0.1   # loopback only unless you set this on purpose (Real is then off)
# Real mode: a local folder of full, unsanitized .md pages. Absolute path, OUTSIDE this repo. Read-only, served on loopback only.
# FIELD_NOTES_DIR=/path/to/your/notes
